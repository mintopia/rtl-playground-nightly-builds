  "components": [
    {
      "name": "Band Navigation",
      "kind": "nav",
      "refersTo": "band",
      "description": "Brand-blue bar with wordmark and site nav; current page underlined.",
      "html": "<header class=\"ds-band\"><a class=\"ds-name\" href=\"#\">RTL Playground Nightly Builds</a><nav><a href=\"#\" aria-current=\"page\">Models</a><a href=\"#\">Matrix</a><a href=\"#\">Releases</a><a href=\"#\">Upstream</a></nav></header>",
      "css": ".ds-band{display:flex;flex-wrap:wrap;align-items:center;gap:0 28px;padding:0 20px;background:var(--brand,#0f4c88);color:#fff;font-family:Overpass,system-ui,sans-serif}.ds-band a{color:inherit;text-decoration:none}.ds-name{font-weight:800;font-size:18px;letter-spacing:-0.01em;padding:14px 0;margin-right:auto}.ds-band nav{display:flex;gap:0 22px;font-weight:600}.ds-band nav a{padding:14px 0;color:var(--brand-soft,#cfe0f3)}.ds-band nav a:hover,.ds-band nav a[aria-current]{color:#fff}.ds-band nav a[aria-current]{box-shadow:inset 0 -3px 0 #fff}.ds-band a:focus-visible{outline:2px solid #fff;outline-offset:2px;border-radius:3px}"
    },
    {
      "name": "History Strip",
      "kind": "custom",
      "refersTo": "status-cell-ok",
      "description": "Signature 14-night build strip: green built, amber some failed, red failed, dashed grey not included.",
      "html": "<div class=\"ds-hs\"><ol class=\"ds-strip\"><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li><li><a href=\"#\" class=\"ds-cell partial\" aria-label=\"partial\"></a></li><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li><li><a href=\"#\" class=\"ds-cell fail\" aria-label=\"fail\"></a></li><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li><li><a href=\"#\" class=\"ds-cell none\" aria-label=\"none\"></a></li><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li><li><a href=\"#\" class=\"ds-cell partial\" aria-label=\"partial\"></a></li><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li><li><a href=\"#\" class=\"ds-cell \" aria-label=\"\"></a></li></ol><div class=\"ds-foot\"><span>16 Oct</span><span>29 Oct</span></div><p class=\"ds-keys\"><span><i class=\"ds-cell\"></i>All built</span><span><i class=\"ds-cell partial\"></i>Some failed</span><span><i class=\"ds-cell fail\"></i>All failed</span><span><i class=\"ds-cell none\"></i>Not included</span></p></div>",
      "css": ".ds-hs{max-width:720px;font-family:Overpass,system-ui,sans-serif}.ds-strip{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(14,1fr);gap:4px}.ds-cell{display:block;height:28px;border-radius:4px;background:var(--ok,#1d8a4f);transition:transform 150ms ease-out,filter 150ms ease-out}a.ds-cell:hover{transform:translateY(-2px);filter:brightness(1.1)}a.ds-cell:focus-visible{outline:2px solid var(--focus,#0f4c88);outline-offset:2px}.ds-cell.partial{background:var(--partial,#b07800)}.ds-cell.fail{background:var(--fail,#c8372d)}.ds-cell.none{background:transparent;border:2px dashed var(--none,#8a96a4)}.ds-foot{display:flex;justify-content:space-between;margin-top:8px;font-size:13px;color:var(--quiet,#566170)}.ds-keys{display:flex;gap:6px 16px;flex-wrap:wrap;margin:8px 0 0;font-size:13px;color:var(--quiet,#566170)}.ds-keys span{display:inline-flex;align-items:center;gap:6px}.ds-keys .ds-cell{width:12px;height:12px;border-radius:3px}.ds-keys .ds-cell.none{border-width:1.5px}"
    },
    {
      "name": "Chipset Chips",
      "kind": "chip",
      "refersTo": "chip-8372",
      "description": "Mono pill per chipset: blue 8372, green 8373.",
      "html": "<span class=\"ds-chip ds-8372\">RTL8372</span> <span class=\"ds-chip ds-8373\">RTL8373</span>",
      "css": ".ds-chip{display:inline-block;font-family:'Overpass Mono',ui-monospace,monospace;font-size:12px;font-weight:600;padding:2px 8px;border-radius:999px;line-height:1.5}.ds-8372{background:var(--c8372-bg,#dfeaf8);color:var(--c8372-ink,#0d4479)}.ds-8373{background:var(--c8373-bg,#dcf1e8);color:var(--c8373-ink,#0b5c40)}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-failed",
      "description": "Red Failed pill for missing builds; amber pill marks commits touching this model.",
      "html": "<span class=\"ds-badge ds-fail\">Failed</span> <span class=\"ds-badge ds-mine\">this model</span>",
      "css": ".ds-badge{display:inline-block;font-family:Overpass,system-ui,sans-serif;font-size:12px;font-weight:700;padding:2px 9px;border-radius:999px;line-height:1.5}.ds-fail{background:var(--fail-bg,#fde6e3);color:var(--fail-ink,#8f1f17)}.ds-mine{background:var(--partial-bg,#fdf1d6);color:var(--partial-ink,#6b4700)}"
    },
    {
      "name": "OEM Download Card",
      "kind": "card",
      "refersTo": "pick-card-primary",
      "description": "Primary pick, always first: 2px blue border, solid blue download button, mono file name, SHA-256 with Copy.",
      "html": "<div class=\"ds-pick ds-primary\"><h3>OEM upgrade</h3><p>First install. Your switch still runs its original firmware: upload this once there.</p><a class=\"ds-dl\" href=\"#\">Download OEM upgrade <span>528 KiB</span></a><span class=\"ds-fname\">rtlplayground-v0.1.0-1b29fb6-20261028-GT_ST024M-oem_upgrade.bin</span><p class=\"ds-hash\"><span>SHA-256</span> <code>bc671f7f54010793…</code><button class=\"ds-copy\">Copy</button></p></div>",
      "css": ".ds-pick{background:var(--surface,#fff);border:1px solid var(--rule,#e1e6ec);border-radius:12px;padding:20px 22px;display:flex;flex-direction:column;gap:10px;box-shadow:0 1px 2px rgb(16 34 56/.06),0 4px 14px rgb(16 34 56/.06);font:15px/1.5 Overpass,system-ui,sans-serif;color:var(--ink,#141a22);max-width:420px}.ds-pick h3{font-size:16px;font-weight:800;margin:0}.ds-pick p{margin:0}.ds-primary{border:2px solid var(--line,#0f4c88)}.ds-dl{display:inline-flex;align-items:center;gap:12px;min-height:46px;padding:0 18px;border-radius:8px;font-weight:800;text-decoration:none;align-self:flex-start;background:var(--brand,#0f4c88);border:1px solid var(--brand,#0f4c88);color:#fff;transition:background-color 150ms ease-out,transform 150ms ease-out}.ds-dl:hover{background:var(--brand-deep,#0a3866)}.ds-dl:active{transform:translateY(1px)}.ds-dl:focus-visible,.ds-copy:focus-visible{outline:2px solid var(--focus,#0f4c88);outline-offset:2px}.ds-dl span{font-weight:400;opacity:.85}.ds-fname,.ds-hash code{font-family:'Overpass Mono',ui-monospace,monospace;font-size:13px;overflow-wrap:anywhere}.ds-hash{display:flex;align-items:center;gap:8px;font-size:13px}.ds-hash>span{color:var(--quiet,#566170)}.ds-copy{font:inherit;font-weight:700;color:var(--link,#0f4c88);background:transparent;border:1px solid var(--field,#8a96a4);border-radius:6px;padding:4px 10px;min-height:32px;cursor:pointer}.ds-copy:hover{background:var(--row,#eef4fb)}"
    },
    {
      "name": "Custom Download Button",
      "kind": "button",
      "refersTo": "button-download",
      "description": "Secondary download: blue outline, Row Hover fill on hover.",
      "html": "<a class=\"ds-dl2\" href=\"#\">Download Custom <span>512 KiB</span></a>",
      "css": ".ds-dl2{display:inline-flex;align-items:center;gap:12px;min-height:46px;padding:0 18px;border-radius:8px;font:800 15px Overpass,system-ui,sans-serif;text-decoration:none;border:1px solid var(--line,#0f4c88);color:var(--link,#0f4c88);transition:background-color 150ms ease-out,transform 150ms ease-out}.ds-dl2:hover{background:var(--row,#eef4fb)}.ds-dl2:active{transform:translateY(1px)}.ds-dl2:focus-visible{outline:2px solid var(--focus,#0f4c88);outline-offset:2px}.ds-dl2 span{font-weight:400;opacity:.85}"
    },
    {
      "name": "Filter Input",
      "kind": "input",
      "refersTo": "input-filter",
      "description": "Find-your-switch search; blue border plus Band Mist halo on focus.",
      "html": "<label class=\"ds-filter\"><span>Find your switch</span><input type=\"search\" placeholder=\"Model, board or chipset\"></label>",
      "css": ".ds-filter{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;font:800 16px Overpass,system-ui,sans-serif;color:var(--ink,#141a22)}.ds-filter input{font:400 16px Overpass,system-ui,sans-serif;width:min(100%,400px);min-height:46px;padding:8px 14px;border:1px solid var(--field,#8a96a4);border-radius:8px;background:var(--surface,#fff);color:var(--ink,#141a22)}.ds-filter input:focus{border-color:var(--brand,#0f4c88);outline:none;box-shadow:0 0 0 3px var(--brand-soft,#cfe0f3)}"
    },
    {
      "name": "Panel Table",
      "kind": "card",
      "refersTo": "panel",
      "description": "White rounded panel holding a dense table: tinted header, hairline rows, hover row.",
      "html": "<div class=\"ds-panel\"><table><thead><tr><th>Model</th><th>Chipset</th><th class=\"n\">Latest build</th></tr></thead><tbody><tr><td><a href=\"#\">GoodTop GT-ST018M</a></td><td><code>GT_ST018M</code></td><td class=\"n\">29 Oct</td></tr><tr><td><a href=\"#\">GoodTop GT-ST024M</a></td><td><code>GT_ST024M</code></td><td class=\"n\">using 28 Oct</td></tr></tbody></table></div>",
      "css": ".ds-panel{background:var(--surface,#fff);border:1px solid var(--rule,#e1e6ec);border-radius:10px;box-shadow:0 1px 2px rgb(16 34 56/.06),0 4px 14px rgb(16 34 56/.06);overflow:hidden;font:15px/1.5 Overpass,system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--ink,#141a22)}.ds-panel table{border-collapse:collapse;width:100%}.ds-panel th,.ds-panel td{text-align:left;padding:11px 16px;border-bottom:1px solid var(--rule,#e1e6ec)}.ds-panel tbody tr:last-child>*{border-bottom:0}.ds-panel thead th{font-size:13px;font-weight:700;color:var(--quiet,#566170);background:var(--head,#f1f4f8)}.ds-panel tbody tr:hover>*{background:var(--row,#eef4fb)}.ds-panel td:first-child{font-weight:700}.ds-panel a{color:var(--link,#0f4c88);text-decoration:none}.ds-panel a:hover{text-decoration:underline}.ds-panel code{font-family:'Overpass Mono',ui-monospace,monospace;font-size:13px;color:var(--quiet,#566170)}.ds-panel .n{text-align:right}"
    },
    {
      "name": "Matrix Pair",
      "kind": "custom",
      "refersTo": "matrix-pair",
      "description": "Green-wash tile with stacked OEM and Custom links per night.",
      "html": "<span class=\"ds-pair\"><a href=\"#\">OEM</a><a href=\"#\">Custom</a></span>",
      "css": ".ds-pair{display:inline-flex;flex-direction:column;gap:2px;background:var(--ok-bg,#e2f4ea);border-radius:6px;padding:2px;min-width:64px}.ds-pair a{padding:0 5px;line-height:24px;text-align:center;font:700 12px Overpass,system-ui,sans-serif;color:var(--ok-ink,#0d5a32);text-decoration:none;border-radius:4px}.ds-pair a:hover{background:var(--ok,#1d8a4f);color:#fff}.ds-pair a:focus-visible{outline:2px solid var(--focus,#0f4c88);outline-offset:1px}"
    }
  ],
  "narrative": {
    "northStar": "The Plain Build Board",
    "overview": "A clean, confident build dashboard for a hobby firmware. One brand-blue band runs across the top of every page and, on the index, flows straight into a blue hero that carries the title, the last-run line and a 14-night history strip. Below it, everything sits on a pale-grey ground in white rounded panels: a filter, a dense switch table, download cards, a commit list, a history table. Status is told in plain colour and plain words, never in metaphor.\n\nDensity is deliberate. Tables run tight (11px by 16px cells), numbers are tabular, board codes and hashes drop into Overpass Mono, and the only decoration is the status colour itself. The site started from a departure-timetable concept and was softened, at the owner's request, into a plain dashboard; the timetable conceits (split-flap type, footnote letters, strike-through cancellations) are rejected outright.\n\nThe OEM upgrade card always comes first and is the only one drawn as primary. The wrong file can brick a switch, so the visual hierarchy does the explaining before anyone reads the copy.",
    "keyCharacteristics": [
      "One brand-blue band; the index hero extends it full-bleed.",
      "Pale-grey ground, white panels with a hairline border and a soft two-layer shadow.",
      "Status colour system: green built, amber some failed, red failed, dashed grey not included.",
      "Pill chips per chipset (blue 8372, green 8373) and red \"Failed\" pill badges.",
      "Overpass for words, Overpass Mono for codes, hashes and chip labels.",
      "OEM card first and primary; Custom second and outlined.",
      "Full light and dark themes driven by the same custom properties."
    ],
    "rules": [
      {
        "name": "The Status-Only Colour Rule",
        "body": "Green, amber and red mean built, some failed and failed. They are never used decoratively, and no other hue may stand in for a status.",
        "section": "colors"
      },
      {
        "name": "The One Blue Rule",
        "body": "Firmware Blue is the only brand colour. It marks the band, the hero, links and the one primary action per view; nothing else gets a saturated fill.",
        "section": "colors"
      },
      {
        "name": "The Paired Theme Rule",
        "body": "Every colour token has a dark counterpart in the same custom property (see the sidecar). New colours are added to both themes or not at all.",
        "section": "colors"
      },
      {
        "name": "The Mono-Means-Machine Rule",
        "body": "Overpass Mono is for strings a user might type, compare or copy (board codes, hashes, file names, chipsets). Human names stay in Overpass.",
        "section": "typography"
      },
      {
        "name": "The No Uppercase Rule",
        "body": "Headers and labels are sentence case at weight, never letter-spaced capitals.",
        "section": "typography"
      },
      {
        "name": "The One Shadow Rule",
        "body": "There is exactly one elevation. Emphasis comes from border weight (the primary card's 2px blue border), not from a bigger shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the OEM upgrade card first and primary (2px blue border, solid blue button); Custom follows, outlined.",
      "**Do** show build state with the four-state cell set: green built, amber some failed, red failed, dashed grey not included.",
      "**Do** use the on-blue status set (hero-ok, hero-partial, hero-fail) for any strip that sits on the brand blue.",
      "**Do** mark every failed build with the red \"Failed\" pill, and pair it with the fallback date where one exists.",
      "**Do** set board codes, hashes, file names and chipsets in Overpass Mono with ligatures off.",
      "**Do** put new content in white panels on the grey ground, with the one panel shadow and a hairline border.",
      "**Do** define every new colour as a custom property in both light and dark themes."
    ],
    "donts": [
      "**Don't** add timetable gimmicks: no departure-board or split-flap styling, no footnote letters, no strike-through \"cancelled\" builds. The owner explicitly asked for a plain dashboard.",
      "**Don't** use green, amber or red for anything other than build status.",
      "**Don't** introduce a second brand colour or a second saturated fill beside Firmware Blue.",
      "**Don't** make the Custom card primary or put it before OEM.",
      "**Don't** stack shadows or raise a card's shadow for emphasis; use border weight.",
      "**Don't** set labels in letter-spaced uppercase."
    ]
  }
}